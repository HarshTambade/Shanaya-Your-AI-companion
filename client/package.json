{
  "name": "shanaya-companion-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync && npm run cap:patch:android && npm run cap:patch:ios",
    "cap:patch:android": "node scripts/patch-capacitor-gradle.mjs",
    "cap:patch:ios": "node scripts/patch-capacitor-ios.mjs",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:add:electron": "cap add @capawesome/capacitor-electron",
    "cap:sync:electron": "npm run build && cap sync @capawesome/capacitor-electron",
    "cap:run:electron": "npm run build && cap sync @capawesome/capacitor-electron && cap run @capawesome/capacitor-electron",
    "models:draco": "node scripts/compress-avatar.mjs",
    "cap:run:ios": "npm run build && cap sync ios && npm run cap:patch:ios && cap run ios",
    "cap:run:android": "npm run build && cap sync android && npm run cap:patch:android && cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/dialog": "^8.0.1",
    "@capacitor/file-transfer": "^2.0.6",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.1",
    "@capawesome/capacitor-electron": "^0.2.2",
    "@capawesome/capacitor-torch": "^8.0.2",
    "@capgo/capacitor-permissions": "^8.2.8",
    "@capgo/capacitor-speech-synthesis": "^8.0.27",
    "@elizaos/capacitor-talkmode": "2.0.0-beta.1",
    "@pinecall/ionic": "^0.2.1",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@stomp/stompjs": "^7.5.0",
    "capacitor-lancedb": "^0.2.2",
    "capacitor-mobile-claw": "^2.5.1",
    "capacitor-mobilecron": "^0.2.24",
    "capacitor-native-agent": "^0.9.16",
    "llama-cpp-capacitor": "^0.1.5",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0",
    "three-stdlib": "^2.36.1",
    "use-browser-llm": "^0.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.2.0"
  }
}
