# For a physical phone, use a reachable HTTPS API URL (or your computer's LAN IP during development).
VITE_API_BASE_URL=
# Public HTTPS origin used for canonical URLs, social previews, schema, robots.txt,
# and sitemap.xml in production builds (for example https://shanaya.example.com).
VITE_SITE_URL=
# Optional standby API. The Node server remains primary; on API network/5xx
# errors the client asks this Python service for the next model step.
VITE_PYTHON_FALLBACK_URL=http://127.0.0.1:8000
# Public Pinecall agent slug; the API key stays in server/.env.
VITE_PINECALL_AGENT_ID=shanaya
# Optional direct installer/store links shown in the Downloads menu. When blank,
# the platform button opens the GitHub Releases page.
VITE_ANDROID_DOWNLOAD_URL=
VITE_IOS_DOWNLOAD_URL=
VITE_MACOS_DOWNLOAD_URL=
VITE_WINDOWS_DOWNLOAD_URL=
VITE_LINUX_DOWNLOAD_URL=
# Optional model override for the native MobileClaw agent. The API key is entered
# in the app and stored by its native plugin; never put that key in this file.
VITE_SHANAYA_ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional. HTTPS URL for a GGUF model downloaded once by the iOS/Android app.
# VITE_OFFLINE_MODEL_URL=https://your-host.example/models/shanaya-instruct-q4.gguf
# Set after running `npm run models:draco` to load the compressed model in web/native builds.
# VITE_AVATAR_MODEL_URL=/models/avatar.draco.glb
