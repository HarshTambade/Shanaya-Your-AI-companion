PORT=3001
# Loopback is safer for local use. Use 0.0.0.0 only when a trusted LAN device needs access.
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173,capacitor://localhost,http://localhost,https://localhost
# Optional remote MCP endpoint. Use HTTPS in production and generate a unique token
# with: openssl rand -hex 32. Keep the token in server/.env, never in a VITE_* value.
MCP_ENABLED=false
MCP_API_TOKEN=
# Base URL of Shanaya's REST API used by the MCP stdio process and MCP tools.
SHANAYA_API_URL=http://127.0.0.1:3001
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FALLBACKS=openai/gpt-oss-20b,llama-3.1-8b-instant
# Per-model cloud request timeout. Connection failures skip the remaining cloud models.
CLOUD_REQUEST_TIMEOUT_MS=10000
# Optional: use a different OpenAI-compatible provider instead of Groq.
# CLOUD_API_URL=https://your-provider.example/v1/chat/completions
# CLOUD_API_KEY=replace_with_your_cloud_provider_api_key
# CLOUD_MODEL_FALLBACKS=your-primary-model,your-fallback-model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gurubot/self-after-dark:latest
# Optional. Server-side Anthropic key for Electron desktop computer use only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional Mithi v1 Flash service URL; for mobile clients use a reachable HTTPS URL.
MITHI_TTS_URL=
# Optional native CallKit/Telecom voice calls. Point this at a trusted server-side
# endpoint that uses the Pinecall SDK/API key and returns { token, server }.
PINECALL_TOKEN_URL=
