# Optional Python fallback service configuration. The primary app is the
# React client + Express server; run Python only as a standby model-step service.
# This Groq-first router is used by that fallback and the optional Python Edition.
# Groq is the primary provider for this fallback router. These current production
# models are tried in order, then secondary APIs, then configured local inference.
# Enterprise accounts may set GROQ_MODELS to their approved model sequence.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.1-8b-instant

# Optional secondary providers. Each comma-separated model is tried in order.
OPENAI_API_KEY=
OPENAI_MODELS=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash

# Local Python llama-cpp-python fallback (optional).
LLAMA_CPP_MODEL_PATH=
LLAMA_CPP_N_CTX=4096
LLAMA_CPP_N_THREADS=4
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_API_KEY=

# API/runtime configuration.
SHANAYA_HOST=127.0.0.1
SHANAYA_PORT=8000
SHANAYA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost,https://localhost
SHANAYA_WORKSPACE=.
APPROVAL_TTL_SECONDS=180
MITHI_TTS_URL=
MITHI_TTS_API_KEY=

# Python Edition frontend only. The primary client uses client/.env and Express.
# Never put provider keys in VITE_ variables.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_OFFLINE_MODEL_URL=

# eBPF loader posts openat events to this local API route.
SHANAYA_SENSES_URL=http://127.0.0.1:8000/api/senses/events
