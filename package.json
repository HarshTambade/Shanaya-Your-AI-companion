{
  "name": "shanaya-ai-companion",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/mobile",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "build:agent-frontend": "npm run build --workspace @shanaya/frontend",
    "models:draco": "npm run models:draco --prefix client",
    "dev:python-fallback": "python3 -m backend.run",
    "dev:with-python-fallback": "concurrently -k -n server,client,python -c magenta,cyan,green \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:python-fallback\"",
    "mcp:stdio": "npm run mcp:stdio --prefix server",
    "dev:ebpf": "sudo python3 ebpf/loader.py --enable-kernel-senses"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
