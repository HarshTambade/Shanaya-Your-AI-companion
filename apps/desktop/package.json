{
  "name": "@shanaya/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "package": "electron-builder"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "ai.projectshanaya.companion",
    "productName": "Shanaya",
    "files": ["main.js", "preload.js"],
    "extraResources": [
      { "from": "../frontend/dist", "to": "frontend/dist" },
      { "from": "../../backend", "to": "backend", "filter": ["**/*"] }
    ],
    "mac": { "category": "public.app-category.productivity" },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage", "deb"] }
  }
}
